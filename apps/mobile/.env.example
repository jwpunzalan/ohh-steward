# Copy to .env.local (git-ignored) and fill in with values from the
# ohhsteward-dev Supabase project. Never commit real values. Expo loads
# EXPO_PUBLIC_*-prefixed variables from .env files automatically; for EAS
# builds, configure the same names as EAS secrets instead.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
